<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <style>
        :root { --sti-blue: #004a99; --sti-dark: #002d5e; }
        body { font-family: 'Segoe UI', sans-serif; background: transparent; margin: 0; padding: 10px; }
        
        .sti-widget {
            background: #ffffff;
            border: 2px solid var(--sti-blue);
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            max-width: 340px;
        }
        h2 { color: var(--sti-blue); font-size: 16px; margin: 0 0 15px; text-align: center; text-transform: uppercase; border-bottom: 2px solid #f0f4f8; padding-bottom: 10px; }
        
        .field { margin-bottom: 15px; }
        label { display: block; font-size: 11px; font-weight: bold; color: #718096; margin-bottom: 5px; text-transform: uppercase; }
        
        select, input { 
            width: 100%; padding: 12px; border: 2px solid #edf2f7; border-radius: 8px; 
            box-sizing: border-box; font-size: 14px; font-weight: 600; color: #2d3748;
        }
        select:focus, input:focus { border-color: var(--sti-blue); outline: none; }

        .results { background: var(--sti-dark); color: white; padding: 15px; border-radius: 10px; margin-top: 15px; }
        .res-line { display: flex; justify-content: space-between; font-size: 12px; margin-bottom: 6px; opacity: 0.9; }
        .res-total { font-size: 22px; font-weight: 800; color: #4ade80; text-align: right; border-top: 1px solid rgba(255,255,255,0.1); margin-top: 10px; padding-top: 10px; }

        .btn-calc { 
            background: #22c55e; color: white; border: none; width: 100%; padding: 15px; 
            border-radius: 8px; font-weight: 800; cursor: pointer; margin-top: 15px; 
            text-transform: uppercase; transition: 0.2s; 
        }
        .btn-calc:hover { background: #16a34a; transform: translateY(-2px); }
    </style>
</head>
<body>

<div class="sti-widget">
    <h2>Инженерный расчет</h2>
    
    <div class="field">
        <label>Продукция</label>
        <select id="pSelect" onchange="calc()">
            <option value="" data-p="0" data-w="0" data-u="ед.">-- Выберите товар --</option>
            <option value="1" data-p="285" data-w="1.85" data-u="карта">Сетка сварная 50х50х3</option>
            <option value="2" data-p="980" data-w="7.30" data-u="карта">Сетка сварная 100х100х4</option>
            <option value="3" data-p="6200" data-w="49.80" data-u="карта">Сетка сварная 150х150х8</option>
            <option value="4" data-p="480" data-w="0.585" data-u="шт">Болт высокопрочный M24x120</option>
            <option value="5" data-p="110" data-w="0.155" data-u="шт">Гайка высокопрочная M24</option>
            </select>
    </div>

    <div class="field">
        <label id="qLabel">Количество</label>
        <input type="number" id="qty" value="1" min="1" oninput="calc()">
    </div>

    <div class="results">
        <div class="res-line"><span>Вес ед.:</span> <span id="wU">0</span> кг</div>
        <div class="res-line"><span>Общий вес:</span> <span id="wT">0</span> кг</div>
        <div class="res-total"><span id="pT">0</span> ₽</div>
    </div>

    <button class="btn-calc" onclick="addToOrder()">Добавить в расчет</button>
</div>

<script>
    function calc() {
        const opt = document.getElementById('pSelect').selectedOptions[0];
        const q = parseFloat(document.getElementById('qty').value) || 0;
        const p = parseFloat(opt.dataset.p);
        const w = parseFloat(opt.dataset.w);

        document.getElementById('qLabel').innerText = "Количество (" + opt.dataset.u + ")";
        document.getElementById('wU').innerText = w;
        document.getElementById('wT').innerText = (w * q).toFixed(2);
        document.getElementById('pT').innerText = (p * q).toLocaleString();
    }

    function addToOrder() {
        const opt = document.getElementById('pSelect').selectedOptions[0];
        const total = document.getElementById('pT').innerText.replace(/\s/g, '');
        if(opt.value === "") return;

        window.parent.postMessage({
            type: 'ADD_ITEM',
            name: opt.text,
            qty: document.getElementById('qty').value,
            price: parseInt(total)
        }, '*');
    }

    window.addEventListener('message', function(e) {
        if(e.data.type === 'SELECT_PROD') {
            const sel = document.getElementById('pSelect');
            for(let i=0; i<sel.options.length; i++){
                if(sel.options[i].text.includes(e.data.name)) {
                    sel.selectedIndex = i;
                    calc();
                    break;
                }
            }
        }
    });
</script>
</body>
</html>
