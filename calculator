<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <style>
        /* Изолированные стили виджета */
        .sti-widget {
            font-family: 'Segoe UI', Tahoma, sans-serif;
            background: #ffffff;
            border: 2px solid #004a99;
            border-radius: 12px;
            padding: 15px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
            max-width: 350px; /* Ограничиваем ширину для универсальности */
            margin: auto;
        }
        .sti-widget h2 { 
            color: #004a99; 
            font-size: 16px; 
            margin: 0 0 15px; 
            text-align: center; 
            text-transform: uppercase; 
            border-bottom: 1px solid #eef;
            padding-bottom: 8px;
        }
        .sti-field { margin-bottom: 12px; }
        .sti-field label { display: block; font-size: 11px; font-weight: bold; color: #666; margin-bottom: 4px; }
        .sti-input { 
            width: 100%; 
            padding: 10px; 
            border: 2px solid #eee; 
            border-radius: 6px; 
            box-sizing: border-box; 
            font-size: 14px; 
            font-weight: 600;
        }
        .sti-input:focus { border-color: #004a99; outline: none; }
        
        .sti-results { 
            background: #004a99; 
            color: white; 
            padding: 12px; 
            border-radius: 8px; 
            margin-top: 15px; 
        }
        .sti-res-row { display: flex; justify-content: space-between; font-size: 12px; margin-bottom: 4px; opacity: 0.9; }
        .sti-total { 
            font-size: 18px; 
            font-weight: 800; 
            color: #4ade80; 
            text-align: right; 
            border-top: 1px solid rgba(255,255,255,0.2); 
            margin-top: 8px; 
            padding-top: 8px; 
        }
        .sti-btn { 
            background: #22c55e; 
            color: white; 
            border: none; 
            width: 100%; 
            padding: 12px; 
            border-radius: 6px; 
            font-weight: 800; 
            cursor: pointer; 
            margin-top: 12px; 
            transition: 0.2s; 
        }
        .sti-btn:hover { background: #16a34a; transform: scale(1.02); }
    </style>
</head>
<body>

<div class="sti-widget">
    <h2>Инженерный расчет</h2>
    
    <div class="sti-field">
        <label>ПРОДУКЦИЯ</label>
        <select id="prod" class="sti-input" onchange="calc()">
            <option value="" data-p="0" data-w="0">-- Выберите --</option>
            <option value="1" data-p="285" data-w="1.85">Сетка сварная 50х50х3</option>
            <option value="2" data-p="980" data-w="7.30">Сетка сварная 100х100х4</option>
            <option value="3" data-p="6200" data-w="49.80">Сетка сварная 150х150х8</option>
            <option value="4" data-p="480" data-w="0.585">Болт высокопрочный M24x120</option>
            <option value="5" data-p="110" data-w="0.155">Гайка высокопрочная M24</option>
        </select>
    </div>

    <div class="sti-field">
        <label>КОЛИЧЕСТВО</label>
        <input type="number" id="qty" class="sti-input" value="1" min="1" oninput="calc()">
    </div>

    <div class="sti-results">
        <div class="sti-res-row"><span>Вес ед.:</span> <span id="w_unit">0</span> кг</div>
        <div class="sti-res-row"><span>Общий вес:</span> <span id="w_total">0</span> кг</div>
        <div class="sti-total"><span id="p_total">0</span> ₽</div>
    </div>

    <button class="sti-btn" onclick="sendToParent()">ДОБАВИТЬ В РАСЧЕТ</button>
</div>

<script>
    function calc() {
        const opt = document.getElementById('prod').selectedOptions[0];
        const qty = parseFloat(document.getElementById('qty').value) || 0;
        const p = parseFloat(opt.dataset.p);
        const w = parseFloat(opt.dataset.w);

        document.getElementById('w_unit').innerText = w;
        document.getElementById('w_total').innerText = (w * qty).toFixed(2);
        document.getElementById('p_total').innerText = (p * qty).toLocaleString();
    }

    function sendToParent() {
        const opt = document.getElementById('prod').selectedOptions[0];
        const price = document.getElementById('p_total').innerText.replace(/\s/g, '');
        if(opt.value === "") return;

        // Отправка данных на любой сайт, где вставлен этот iframe
        window.parent.postMessage({
            type: 'addToCart',
            name: opt.text,
            qty: document.getElementById('qty').value,
            price: parseInt(price)
        }, '*');
    }

    // Слушаем команды от сайта (если нужно выбрать товар кликом по карточке)
    window.addEventListener('message', function(e) {
        if(e.data.type === 'setProduct') {
            const sel = document.getElementById('prod');
            for(let i=0; i<sel.options.length; i++){
                if(sel.options[i].text.includes(e.data.name)) {
                    sel.selectedIndex = i;
                    calc();
                    break;
                }
            }
        }
    });
</script>
</body>
</html>
